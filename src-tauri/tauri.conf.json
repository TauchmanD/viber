{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tmux Agent Grid",
  "version": "0.2.0",
  "identifier": "dev.denis.tmux-agent-grid",
  "build": { "frontendDist": "../public" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Tmux Agent Grid",
      "width": 1440,
      "height": 900,
      "minWidth": 900,
      "minHeight": 600,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
